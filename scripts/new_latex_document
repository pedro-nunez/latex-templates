#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage:
    new_latex_document TEMPLATE PROJECT_NAME [OPTIONS]

Templates:
    note, exercises, beamer, report

Options:
    --title TEXT  Set the title (default: Title; not for exercises).
    --user FILE   Use this settings file instead of config/user.sh.
    --todo        Include to-do support, initially hidden.
    --comments    Include author comments, initially hidden.
    --lean        Include Lean code-listing support.
    --no-git      Do not initialize a local Git repository.
    --no-github   Do not create a GitHub repository (default).
    --github      Create and push a GitHub repository.
    --private     Make the GitHub repository private (default).
    --public      Make the GitHub repository public.
    -h, --help    Show this help message.

Creates PROJECT_NAME in the current directory. Project names may contain
letters, numbers, dots, underscores, and hyphens, but cannot be . or ..
or begin with a hyphen.

Personal settings are required. Relative --user paths are resolved from
the directory where you run this command. Titles are LaTeX source.
USAGE
}

die() {
    printf 'new_latex_document: error: %s\n' "$*" >&2
    exit 1
}

require_file() {
    [[ -f "$1" && -r "$1" ]] || die "file missing or unreadable: $1"
}

cleanup_on_failure() {
    if [[ "${created_target_dir}" -eq 1 && "${local_creation_complete}" -eq 0 ]]; then
        printf 'Removing incomplete project: %s\n' "${target_dir}" >&2
        rm -rf -- "${target_dir}"
    fi
}

template=""
project_name=""
title="Title"
title_was_set=0
user_file=""
use_todo=0
use_comments=0
use_lean=0
use_git=1
use_github=0
github_visibility="private"
github_visibility_was_set=0

if [[ $# -eq 0 ]]; then
    usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --title)
            [[ $# -ge 2 ]] || die "--title requires a value"
            title="$2"
            title_was_set=1
            shift
            ;;
        --user)
            [[ $# -ge 2 && -n "$2" ]] || die "--user requires a filename"
            user_file="$2"
            shift
            ;;
        --todo)
            use_todo=1
            ;;
        --comments)
            use_comments=1
            ;;
        --lean)
            use_lean=1
            ;;
        --no-git)
            use_git=0
            ;;
        --no-github)
            use_github=0
            ;;
        --github)
            use_github=1
            ;;
        --private|--public)
            github_visibility="${1#--}"
            github_visibility_was_set=1
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            if [[ -z "${template}" ]]; then
                template="$1"
            elif [[ -z "${project_name}" ]]; then
                project_name="$1"
            else
                die "unexpected extra argument: $1"
            fi
            ;;
    esac
    shift
done

[[ -n "${template}" ]] || die "missing TEMPLATE"
[[ -n "${project_name}" ]] || die "missing PROJECT_NAME"

case "${template}" in
    note|exercises|beamer|report) ;;
    *) die "unknown template: ${template}" ;;
esac

if [[ ! "${project_name}" =~ ^[A-Za-z0-9._-]+$ ||
      "${project_name}" == "." || "${project_name}" == ".." ]]; then
    die "invalid project name: ${project_name}"
fi

if [[ "${template}" == exercises && "${title_was_set}" -eq 1 ]]; then
    die "--title is not supported for exercises; edit the course metadata in main.tex"
fi

if [[ "${use_github}" -eq 1 && "${use_git}" -eq 0 ]]; then
    die "--github requires local Git; remove --no-git or omit --github"
fi

if [[ "${github_visibility_was_set}" -eq 1 && "${use_github}" -eq 0 ]]; then
    printf 'new_latex_document: warning: GitHub visibility ignored without --github\n' >&2
fi

# Locate the repository, including when this command is symlinked.
script_path="${BASH_SOURCE[0]}"
while [[ -L "${script_path}" ]]; do
    script_dir=$(
        cd -- "$(dirname -- "${script_path}")" >/dev/null && pwd -P
    )
    link_target=$(readlink -- "${script_path}")
    if [[ "${link_target}" == /* ]]; then
        script_path="${link_target}"
    else
        script_path="${script_dir}/${link_target}"
    fi
done

repo_dir=$(
    cd -- "$(dirname -- "${script_path}")/.." >/dev/null && pwd -P
)
preamble_builder="${repo_dir}/scripts/build_preamble"
skeleton_file="${repo_dir}/sources/skeletons/${template}.tex"
auxiliary_dir="${repo_dir}/sources/auxiliary"
target_dir="${PWD}/${project_name}"

if [[ -e "${target_dir}" || -L "${target_dir}" ]]; then
    die "target already exists: ${target_dir}"
fi

if [[ -z "${user_file}" ]]; then
    user_file="${repo_dir}/config/user.sh"
    [[ -f "${user_file}" && -r "${user_file}" ]] ||
        die "create ${user_file} by copying ${repo_dir}/config/user_example.sh and editing your details, or use --user FILE"
elif [[ "${user_file}" != /* ]]; then
    user_file="${PWD}/${user_file}"
fi

require_file "${user_file}"
require_file "${preamble_builder}"
require_file "${skeleton_file}"
require_file "${auxiliary_dir}/refs.bib"
require_file "${auxiliary_dir}/gitignore"
if [[ "${use_lean}" -eq 1 ]]; then
    require_file "${auxiliary_dir}/lstlean.tex"
fi

preamble_args=("${template}" --user "${user_file}")
if [[ "${title_was_set}" -eq 1 ]]; then
    preamble_args+=(--title "${title}")
fi
if [[ "${use_todo}" -eq 1 ]]; then
    preamble_args+=(--todo)
fi
if [[ "${use_comments}" -eq 1 ]]; then
    preamble_args+=(--comments)
fi
if [[ "${use_lean}" -eq 1 ]]; then
    preamble_args+=(--lean)
fi

if [[ "${use_git}" -eq 1 ]]; then
    command -v git >/dev/null 2>&1 || die "git not found; install Git or use --no-git"
fi

if [[ "${use_github}" -eq 1 ]]; then
    command -v gh >/dev/null 2>&1 || die "GitHub CLI 'gh' not found"
    gh auth status >/dev/null 2>&1 || die "run 'gh auth login' first"
    github_owner=$(gh api user --jq '.login')
    if gh repo view "${github_owner}/${project_name}" >/dev/null 2>&1; then
        die "GitHub repository already exists: ${github_owner}/${project_name}"
    fi
fi

created_target_dir=0
local_creation_complete=0
trap cleanup_on_failure EXIT

mkdir -- "${target_dir}"
created_target_dir=1

{
    bash "${preamble_builder}" "${preamble_args[@]}"
    printf '\n%% Source: sources/skeletons/%s.tex\n\n' "${template}"
    cat -- "${skeleton_file}"
} > "${target_dir}/main.tex"

cp -- "${auxiliary_dir}/refs.bib" "${target_dir}/refs.bib"
cp -- "${auxiliary_dir}/gitignore" "${target_dir}/.gitignore"
if [[ "${use_lean}" -eq 1 ]]; then
    cp -- "${auxiliary_dir}/lstlean.tex" "${target_dir}/lstlean.tex"
fi

{
    printf '# %s\n\n' "${project_name}"
    printf 'Document type: %s\n\n' "${template}"
    cat <<'README'
Created from [latex-templates](https://github.com/pedro-nunez/latex-templates).

## Files

- `main.tex`: complete preamble, document metadata, and body.
- `refs.bib`: bibliography database.
- `.gitignore`: ignored LaTeX build products and editor files.

Edit `main.tex` directly. The project does not depend on the template repository
or its user settings after creation.

## Build

```bash
latexmk -pdf main.tex
```
README
    if [[ "${use_todo}" -eq 1 ]]; then
        cat <<'README'

## To-do notes

Add `\showtodostrue` before `\begin{document}` to display `\todo{...}` notes.
README
    fi
    if [[ "${use_comments}" -eq 1 ]]; then
        cat <<'README'

## Author comments

Define commands such as `\newauthorcomment{alice}{Alice}{red}` in the preamble.
Add `\showcommentstrue` before `\begin{document}` to display `\alice{...}` comments.
README
    fi
    if [[ "${use_lean}" -eq 1 ]]; then
        cat <<'README'

## Lean code

The accompanying `lstlean.tex` provides the Lean language definition.
Use the `leancode` environment; in Beamer, put listings in a `[fragile]` frame.
README
    fi
} > "${target_dir}/README.md"

if [[ "${use_git}" -eq 1 ]]; then
    git -C "${target_dir}" init -q
    git -C "${target_dir}" var GIT_AUTHOR_IDENT >/dev/null 2>&1 ||
        die "Git author identity is not configured for this project; set user.name and user.email, or use --no-git"
    git -C "${target_dir}" add .
    git -C "${target_dir}" commit -q -m "Initial commit"
fi

# Keep the completed local project even if GitHub creation or pushing fails.
local_creation_complete=1

if [[ "${use_github}" -eq 1 ]]; then
    if ! gh repo create "${github_owner}/${project_name}" \
        --source "${target_dir}" --remote origin --push "--${github_visibility}"; then
        die "GitHub creation or push failed; local project preserved at ${target_dir}"
    fi
fi

printf 'Created project: %s\n' "${target_dir}"
printf 'Template: %s\nUser info: %s\n' "${template}" "${user_file}"
