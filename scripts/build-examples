#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  build-examples [TEMPLATE] [--clean]

Templates:
  note
  exercises
  beamer
  longform

Options:
  --clean       Remove generated example build products.
  -h, --help    Show this help message.

With no TEMPLATE, all examples are selected.
USAGE
}

die() {
  printf 'build-examples: error: %s\n' "$*" >&2
  exit 1
}

script_path="${BASH_SOURCE[0]}"

while [[ -L "${script_path}" ]]; do
  script_dir=$(
    cd -- "$(dirname -- "${script_path}")" >/dev/null 2>&1
    pwd
  )

  link_target=$(readlink -- "${script_path}")

  if [[ "${link_target}" == /* ]]; then
    script_path="${link_target}"
  else
    script_path="${script_dir}/${link_target}"
  fi
done

script_dir=$(
  cd -- "$(dirname -- "${script_path}")" >/dev/null 2>&1
  pwd
)

repo_dir=$(
  cd -- "${script_dir}/.." >/dev/null 2>&1
  pwd
)

selected_template=""
clean=0

if [[ $# -eq 0 ]]; then
  selected_template="all"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --clean)
      clean=1
      shift
      ;;
    --*)
      die "unknown option: $1"
      ;;
    note|exercises|beamer|longform)
      if [[ -n "${selected_template}" && "${selected_template}" != "all" ]]; then
        die "unexpected extra template: $1"
      fi
      selected_template="$1"
      shift
      ;;
    *)
      die "unknown template: $1. Expected one of: note, exercises, beamer, longform"
      ;;
  esac
done

if [[ -z "${selected_template}" ]]; then
  selected_template="all"
fi

case "${selected_template}" in
  all)
    templates=(note exercises beamer longform)
    ;;
  note|exercises|beamer|longform)
    templates=("${selected_template}")
    ;;
  *)
    die "internal error: invalid template selection '${selected_template}'"
    ;;
esac

command -v latexmk >/dev/null 2>&1 || die "latexmk not found"

build_root="${repo_dir}/examples/build"
pdf_dir="${repo_dir}/examples/pdf"

if [[ "${clean}" -eq 1 ]]; then
  rm -rf -- "${build_root}"
  for template in "${templates[@]}"; do
    rm -f -- "${pdf_dir}/${template}.pdf"
  done
  exit 0
fi

mkdir -p -- "${build_root}" "${pdf_dir}"

for template in "${templates[@]}"; do
  source_dir="${repo_dir}/examples/sources/${template}"
  template_preamble="${repo_dir}/common/${template}-preamble.tex"
  work_dir="${build_root}/${template}"

  [[ -d "${source_dir}" ]] || die "example source directory not found: ${source_dir}"
  [[ -f "${source_dir}/main.tex" ]] || die "example source not found: ${source_dir}/main.tex"
  [[ -f "${source_dir}/refs.bib" ]] || die "example bibliography not found: ${source_dir}/refs.bib"
  [[ -f "${template_preamble}" ]] || die "template preamble not found: ${template_preamble}"

  rm -rf -- "${work_dir}"
  mkdir -p -- "${work_dir}"

  cp -- "${source_dir}/main.tex" "${work_dir}/main.tex"
  cp -- "${source_dir}/refs.bib" "${work_dir}/refs.bib"

  {
    printf '%% Generated from a LaTeX document template; edit as needed.\n\n'
    cat -- "${template_preamble}"
  } > "${work_dir}/preamble.tex"

  printf 'Building %s example...\n' "${template}"

  (
    cd "${work_dir}"
    latexmk -pdf -interaction=nonstopmode -halt-on-error -file-line-error main.tex
  )

  cp -- "${work_dir}/main.pdf" "${pdf_dir}/${template}.pdf"
  rm -rf -- "${work_dir}"
  rmdir -- "${build_root}" 2>/dev/null || true

  printf 'Wrote %s\n' "${pdf_dir}/${template}.pdf"
done
