#!/usr/bin/env bash
set -euo pipefail

# Locate this script, including when invoked through a symlink.
script_path="${BASH_SOURCE[0]}"
while [[ -L "${script_path}" ]]; do
    script_dir=$(
        cd -- "$(dirname -- "${script_path}")" >/dev/null && pwd -P
    )
    link_target=$(readlink -- "${script_path}")
    if [[ "${link_target}" == /* ]]; then
        script_path="${link_target}"
    else
        script_path="${script_dir}/${link_target}"
    fi
done

script_dir=$(
    cd -- "$(dirname -- "${script_path}")" >/dev/null && pwd -P
)

bash "${script_dir}/build_templates"
bash "${script_dir}/build_examples"
