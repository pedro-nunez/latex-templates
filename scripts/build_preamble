#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage:
    build_preamble TEMPLATE [OPTIONS]

Templates:
    note, exercises, beamer, report

Options:
    --todo        Include todo support, initially hidden.
    --comments    Include author comments, initially hidden.
    --lean        Include Lean code-listing support.
    -h, --help    Show this help message.

Writes the preamble to standard output.
Templates requiring bib file expect a separate refs.bib file.
Lean support expects a separate lstlean.tex file.
USAGE
}

die() {
    printf 'build_preamble: error: %s\n' "$*" >&2
    exit 1
}

template=""
use_todo=0
use_comments=0
use_lean=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --todo)
            use_todo=1
            ;;
        --comments)
            use_comments=1
            ;;
        --lean)
            use_lean=1
            ;;
        note|exercises|beamer|report)
            [[ -z "${template}" ]] || die "unexpected extra template: $1"
            template="$1"
            ;;
        *)
            die "unknown argument: $1 (use --help for usage)"
            ;;
    esac
    shift
done

[[ -n "${template}" ]] || die "missing TEMPLATE (use --help for usage)"

# Locate the repository, including when this command is symlinked.
script_path="${BASH_SOURCE[0]}"

# Loop to resolve symbolic link.
while [[ -L "${script_path}" ]]; do
    script_dir=$(
        cd -- "$(dirname -- "${script_path}")" >/dev/null && pwd -P
    )
    link_target=$(readlink -- "${script_path}")

    if [[ "${link_target}" == /* ]]; then
        script_path="${link_target}"
    else
        script_path="${script_dir}/${link_target}"
    fi
done

repo_dir=$(
    cd -- "$(dirname -- "${script_path}")/.." >/dev/null && pwd -P
)
preamble_dir="${repo_dir}/sources/preambles"
auxiliary_dir="${repo_dir}/sources/auxiliary"

case "${template}" in
    note|report)
        preamble_files=(standard_packages.tex standard_theorems.tex)
        ;;
    exercises)
        preamble_files=(exercises_packages.tex exercises_preamble.tex)
        ;;
    beamer)
        preamble_files=(beamer_packages.tex beamer_theme.tex)
        ;;
esac

if [[ "${use_todo}" -eq 1 ]]; then
    preamble_files+=(todo.tex)
fi
if [[ "${use_comments}" -eq 1 ]]; then
    preamble_files+=(author_comments.tex)
fi
if [[ "${use_lean}" -eq 1 ]]; then
    preamble_files+=(lean_preamble.tex)
fi

# Validate all selected files before writing any LaTeX.
for preamble_file in "${preamble_files[@]}"; do
    file_path="${preamble_dir}/${preamble_file}"
    [[ -f "${file_path}" && -r "${file_path}" ]] ||
        die "preamble file missing or unreadable: ${file_path}"
done

if [[ "${use_lean}" -eq 1 ]]; then
    lean_file="${auxiliary_dir}/lstlean.tex"
    [[ -f "${lean_file}" && -r "${lean_file}" ]] ||
        die "Lean language file missing or unreadable: ${lean_file}"
fi

printf '%% Preamble generated by build_preamble for %s.\n' "${template}"

for preamble_file in "${preamble_files[@]}"; do
    printf '\n%% Source: sources/preambles/%s\n\n' "${preamble_file}"
    cat -- "${preamble_dir}/${preamble_file}"
    printf '\n'
done
