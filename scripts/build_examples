#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage:
    build_examples [TEMPLATE]

Templates:
    note, exercises, beamer, report

With no TEMPLATE, or with "all", build all four examples.
Writes complete .tex files and compiled PDFs directly into examples/.
Uses the generic defaults provided by build_preamble.

Options:
    -h, --help    Show this help message.
USAGE
}

die() {
    printf 'build_examples: error: %s\n' "$*" >&2
    exit 1
}

require_file() {
    [[ -f "$1" && -r "$1" ]] || die "file missing or unreadable: $1"
}

[[ $# -le 1 ]] || die "expected at most one template"

case "${1-all}" in
    -h|--help)
        usage
        exit 0
        ;;
    all)
        templates=(note exercises beamer report)
        ;;
    note|exercises|beamer|report)
        templates=("$1")
        ;;
    *)
        die "unknown template: $1 (use --help for usage)"
        ;;
esac

command -v latexmk >/dev/null 2>&1 || die "latexmk not found"

# Locate the repository, including when this command is symlinked.
script_path="${BASH_SOURCE[0]}"
while [[ -L "${script_path}" ]]; do
    script_dir=$(
        cd -- "$(dirname -- "${script_path}")" >/dev/null && pwd -P
    )
    link_target=$(readlink -- "${script_path}")
    if [[ "${link_target}" == /* ]]; then
        script_path="${link_target}"
    else
        script_path="${script_dir}/${link_target}"
    fi
done

repo_dir=$(
    cd -- "$(dirname -- "${script_path}")/.." >/dev/null && pwd -P
)
source_dir="${repo_dir}/sources/examples"
output_dir="${repo_dir}/examples"
preamble_builder="${repo_dir}/scripts/build_preamble"

require_file "${preamble_builder}"
require_file "${source_dir}/refs.bib"

for template in "${templates[@]}"; do
    require_file "${source_dir}/${template}.tex"
    for extension in tex pdf; do
        [[ ! -d "${output_dir}/${template}.${extension}" ]] ||
            die "output path is a directory: ${output_dir}/${template}.${extension}"
    done
done

mkdir -p -- "${output_dir}"

build_root=$(mktemp -d "${repo_dir}/.build_examples.XXXXXX")
trap 'rm -rf -- "${build_root}"' EXIT

# Build all selected examples before replacing existing outputs.
for template in "${templates[@]}"; do
    preamble_args=("${template}" --todo)

    case "${template}" in
        note)
            preamble_args+=(--title "Example note document" --comments)
            ;;
        exercises)
            # Course, sheet number, and deadline are set in the example body.
            ;;
        beamer)
            preamble_args+=(--title "Beamer presentation example")
            ;;
        report)
            preamble_args+=(--title "Example report document" --comments)
            ;;
    esac

    build_dir="${build_root}/${template}"
    mkdir -- "${build_dir}"

    {
        bash "${preamble_builder}" "${preamble_args[@]}"
        printf '\n%% Source: sources/examples/%s.tex\n\n' "${template}"
        cat -- "${source_dir}/${template}.tex"
    } > "${build_dir}/${template}.tex"

    cp -- "${source_dir}/refs.bib" "${build_dir}/refs.bib"

    printf 'Building %s example...\n' "${template}"

    (
        cd -- "${build_dir}"
        latexmk -pdf -interaction=nonstopmode -halt-on-error \
            -file-line-error "${template}.tex"
    )

    [[ -s "${build_dir}/${template}.pdf" ]] ||
        die "no PDF produced for ${template}"
done

for template in "${templates[@]}"; do
    for extension in tex pdf; do
        mv -f -- "${build_root}/${template}/${template}.${extension}" \
            "${output_dir}/${template}.${extension}"
        printf 'Wrote %s\n' "${output_dir}/${template}.${extension}"
    done
done
